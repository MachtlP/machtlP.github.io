---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}
  {% assign url = page.url %}
  {% assign ext = url | split: "." | last %}
  {% unless url == "/404.html" or url == "/sitemap.xml" or url == "/photography/" or url contains "/assets/" or ext == "css" or ext == "js" or ext == "xml" or ext == "json" %}
  <url>
    <loc>{{ url | absolute_url }}</loc>
  </url>
  {% endunless %}
{% endfor %}
{% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
  </url>
{% endfor %}
</urlset>
